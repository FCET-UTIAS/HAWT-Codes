function MC_move_stepper_med(s_port, num_step, direction)

%---------------------------------------------------------------------------
% Function to move the stepper motor (slower speed)
% Description: Same as MC_move_stepper, but with a lower starting speed, a
% lower max rate and a gentler slope (first rate 10, max rate 27, slope 5).
% Sends the direction, the number of steps and the go command to the
% stepper motor controller. The speed is reset on every call. The function
% returns after sending the commands and does not wait for the move to
% finish. A motor must already be selected with MC_select_motor.
%
% INPUTS: s_port    - serial port information
%         num_step  - integer number of steps to rotate the traverse
%         direction - '+' or '-'. Required by the current code, since it is
%                     sent to the controller on every call.
% OUTPUTS: N/A
%
% HISTORY: 
%   Modified May 10, 2012 (Jason H.) - to reset speed on every command.
% 
%---------------------------------------------------------------------------
 
%% Main Code
% set speed paramters
fprintf(s_port, 'f 10');        % Set first rate (starting speed)
fprintf(s_port, 'r 27');        % Set max rate (speed)
fprintf(s_port, 's 5');        % Set slope (acceleration)

% move stepper
fprintf(s_port, direction)
fprintf(s_port, ['n ', int2str(num_step)])
fprintf(s_port, 'g')
